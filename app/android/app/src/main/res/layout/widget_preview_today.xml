<?xml version="1.0" encoding="utf-8"?>
<!-- Static sample content for the widget picker (Android 12+ previewLayout) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@drawable/widget_background"
    android:paddingStart="14dp" android:paddingEnd="14dp" android:paddingTop="10dp" android:paddingBottom="10dp">
    <TextView android:layout_width="match_parent" android:layout_height="32dp" android:gravity="center_vertical" android:text="@string/preview_today_title" android:textSize="16sp" android:textStyle="bold" android:textColor="#FFA78BFA" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="22dp" android:layout_marginTop="4dp" android:gravity="center_vertical" android:orientation="horizontal">
        <ImageView android:layout_width="14dp" android:layout_height="14dp" android:layout_marginEnd="6dp" android:src="@drawable/ic_widget_events" android:importantForAccessibility="no" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/section_events" android:textSize="11sp" android:textStyle="bold" android:textColor="#99FFFFFF" />
    </LinearLayout>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="2dp" android:paddingBottom="2dp" android:text="@string/preview_event_1" android:textSize="13sp" android:maxLines="1" android:ellipsize="end" android:textColor="#FFFFFFFF" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="2dp" android:paddingBottom="2dp" android:text="@string/preview_event_2" android:textSize="13sp" android:maxLines="1" android:ellipsize="end" android:textColor="#FFFFFFFF" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="22dp" android:layout_marginTop="4dp" android:gravity="center_vertical" android:orientation="horizontal">
        <ImageView android:layout_width="14dp" android:layout_height="14dp" android:layout_marginEnd="6dp" android:src="@drawable/ic_widget_tasks" android:importantForAccessibility="no" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/section_tasks" android:textSize="11sp" android:textStyle="bold" android:textColor="#99FFFFFF" />
    </LinearLayout>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="2dp" android:paddingBottom="2dp" android:text="@string/preview_task_1" android:textSize="13sp" android:maxLines="1" android:ellipsize="end" android:textColor="#FFFFFFFF" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="22dp" android:layout_marginTop="4dp" android:gravity="center_vertical" android:orientation="horizontal">
        <ImageView android:layout_width="14dp" android:layout_height="14dp" android:layout_marginEnd="6dp" android:src="@drawable/ic_widget_shopping" android:importantForAccessibility="no" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/section_shopping" android:textSize="11sp" android:textStyle="bold" android:textColor="#99FFFFFF" />
    </LinearLayout>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="2dp" android:paddingBottom="2dp" android:text="@string/preview_item_1" android:textSize="13sp" android:maxLines="1" android:ellipsize="end" android:textColor="#FFFFFFFF" />
</LinearLayout>
