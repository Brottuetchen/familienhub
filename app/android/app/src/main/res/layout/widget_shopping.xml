<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_shopping_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView android:id="@+id/widget_bg" android:layout_width="match_parent" android:layout_height="match_parent"
        android:scaleType="fitXY" android:src="@drawable/widget_background" android:importantForAccessibility="no" />

    <LinearLayout android:id="@+id/widget_content" android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical" android:paddingStart="14dp" android:paddingEnd="14dp"
        android:paddingTop="7dp" android:paddingBottom="14dp">

        <TextView android:id="@+id/shopping_count" android:layout_width="match_parent" android:layout_height="34dp"
            android:gravity="center_vertical" android:textColor="#FF2FB36D" android:textSize="15sp"
            android:textStyle="bold" android:maxLines="1" />

        <TextView android:id="@+id/shopping_items" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
            android:layout_marginTop="6dp" android:textColor="#FFFFFFFF" android:textSize="13sp" android:ellipsize="end" />

        <TextView android:id="@+id/shopping_updated" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="end" android:textColor="#80FFFFFF" android:textSize="11sp" />
    </LinearLayout>
</FrameLayout>
