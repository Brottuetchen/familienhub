# Familienhub - example configuration. EVERYTHING HERE IS OPTIONAL: the hub starts with no .env at all.
# To change something, copy this file to .env next to docker-compose.yml and uncomment/edit the lines.
# Plugins (Nextcloud, Home Assistant, Shelfarr, Cookidoo, weather) can also be entered later as admin
# in the app under More -> Settings (no restart needed).

APP_NAME=Familienhub
ENVIRONMENT=production
TIMEZONE=Europe/Berlin
# SECRET_KEY signs sign-in tokens and encrypts stored plugin credentials. Leave it empty: the hub then
# generates a key on first start and keeps it in the data volume (/app/data/secret_key). Only set it
# yourself if you want to manage the key outside the volume; never change it later (stored credentials
# would become unreadable and everyone is signed out).
# Generate one: python3 -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Set to true when the hub is served over HTTPS only (behind a reverse proxy).
SECURE_COOKIES=false
# Empty is fine for the app and for the web app on the same address (same-origin). Only needed when a
# web page on another address calls the API, e.g. https://hub.example.org
CORS_ORIGINS=

# Setup: the first person who opens a new hub creates the admin account. Set this to true if the hub is
# reachable from the internet before setup is done: it then needs the setup code from the server log
# (docker compose logs familienhub).
SETUP_REQUIRE_CODE=false

# --- Database (docker-compose) ---
# The database is only reachable inside the compose network. Defaults are fine; to change the password,
# do it before the first start (the database keeps the password it was created with).
# POSTGRES_USER=familienhub
# POSTGRES_PASSWORD=familienhub
# POSTGRES_DB=familienhub
# Port on the host and image version (default: latest)
# PORT=8000
# FAMILIENHUB_VERSION=latest

# --- Anmeldung über OIDC (z. B. Authentik, Keycloak) – optional ---
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI_WEB=https://hub.example.org/api/auth/oidc/callback
OIDC_REDIRECT_URI_APP=https://hub.example.org/api/auth/oidc/callback
OIDC_AUTO_CREATE=false

# --- Push ---
# Web Push (browser, iPhone web app): optional. Without keys the hub generates them once into
# DATA_DIR/vapid.json. Own keys: python -m scripts.generate_vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact for push services; empty = email of the first admin
VAPID_EMAIL=
# Android (Firebase Cloud Messaging): Dienstkonto-JSON einbinden (siehe docker-compose.yml)
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_FILE=

# ntfy (optional): push for iPhones and anyone without the app. Each person subscribes to their own secret topic.
# NTFY_URL=https://ntfy.sh
# NTFY_PUBLIC_URL=       # address for the ntfy app if different (e.g. hub publishes via LAN)
# NTFY_TOKEN=            # only if the server denies anonymous publishing (token with write access to fh_*)
# HUB_PUBLIC_URL=        # reachable address of the hub; enables click links and reminder buttons

# --- Plugins ---
# Einzelne Plugins abschalten, z. B. PLUGINS_DISABLED=weather
PLUGINS_DISABLED=
# Plugins installable from GitHub in the app (Administration → Plugins & access). false = installer off.
# Needs a persistent volume at DATA_DIR (the default compose file has one).
PLUGIN_INSTALL_ENABLED=true

# Nextcloud/CalDAV: Konten trägt jede Person selbst in der App ein. Optionaler gemeinsamer Kalender:
CALDAV_URL=
CALDAV_USERNAME=
CALDAV_PASSWORD=

# Habitica: eigene User-ID/API-Zugangsdaten verbindet jede Person in der App.
# Keine globalen Habitica-Nutzerzugänge. Der Server wird vom Betreiber festgelegt.
HABITICA_URL=https://habitica.com
# Leer = native Writes gesperrt. Erst nach geprüftem Single-Writer-Cutover freigeben;
# kommaseparierte geprüfte Server|Habitica-Konto-UUID-Paare, niemals Selbstfreigabe in der Kontomaske.
# Vollständige Voraussetzungen: docs/AUFGABENPROVIDER.md
HABITICA_NATIVE_WRITE_ACCOUNTS=

# Home Assistant: Einkaufsliste, Cookidoo-Essensplan und Haus-Karte
HOMEASSISTANT_URL=
HOMEASSISTANT_TOKEN=
HA_SHOPPING_TODO=todo.einkaufsliste
HA_RECIPE_SHOPPING_TODO=todo.cookidoo_einkaufsliste
HA_MEALPLAN_CALENDAR=calendar.cookidoo_speiseplan
# Haus-Karte in Heute: bis zu 6 Entitäts-IDs in Anzeigereihenfolge; leer = ausgeblendet.
# Beispiel: sensor.room_temperature,binary_sensor.baby_monitor,sensor.washer_status
HA_HOUSE_ENTITIES=
# Separate Schreibfreigabe: max. 6 light/switch/script/scene-IDs. Leer = keine Geräteaktionen.
# Die Leseauswahl oben erteilt niemals Schreibrechte. Nur bewusst familiengeeignete Aktionen freigeben.
HA_HOUSE_WRITE_ENTITIES=

# Shelfarr: Bücher und Hörbücher
SHELFARR_URL=
SHELFARR_TOKEN=
SHELFARR_LANGUAGE=de
SHELFARR_USER_MAP=

# Cookidoo: Rezepte suchen und in den Wochenplan legen (Konto mit Abo)
COOKIDOO_EMAIL=
COOKIDOO_PASSWORD=
COOKIDOO_COUNTRY=de
COOKIDOO_LANGUAGE=de-DE

# Wetter (Open-Meteo, kein Schlüssel)
WEATHER_LATITUDE=52.52
WEATHER_LONGITUDE=13.405
WEATHER_LOCATION_NAME=Zuhause

# Paperless-ngx: Dokumente und Fristen. Jede Person verbindet ihr eigenes API-Token in der App.
PAPERLESS_URL=
PAPERLESS_PUBLIC_URL=

# Seerr (Jellyseerr/Overseerr): Filme und Serien wünschen. Der Hub handelt als passender Seerr-Nutzer.
SEERR_URL=
SEERR_API_KEY=
SEERR_USER_MAP=
