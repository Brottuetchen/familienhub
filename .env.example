# Familienhub – Beispielkonfiguration. Kopieren nach .env und anpassen.
# Plugins (Nextcloud, Home Assistant, Shelfarr, Cookidoo, Wetter) lassen sich auch später
# als Admin in der App unter Mehr → Einstellungen eintragen (ohne Neustart).

APP_NAME=Familienhub
ENVIRONMENT=production
TIMEZONE=Europe/Berlin
# Zufälligen Wert erzeugen: python3 -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=
SECURE_COOKIES=true
# Nur nötig, wenn eine andere Web-Adresse auf die API zugreift; leer = nur gleiche Herkunft (sicherer Standard)
CORS_ORIGINS=

# --- Datenbank (docker-compose) ---
POSTGRES_USER=familienhub
POSTGRES_PASSWORD=
POSTGRES_DB=familienhub

# --- Anmeldung über OIDC (z. B. Authentik, Keycloak) – optional ---
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI_WEB=https://hub.example.org/api/auth/oidc/callback
OIDC_REDIRECT_URI_APP=https://hub.example.org/api/auth/oidc/callback
OIDC_AUTO_CREATE=false

# --- Push ---
# Web Push (Browser, iPhone-PWA): cd backend && python -m scripts.generate_vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:admin@example.org
# Android (Firebase Cloud Messaging): Dienstkonto-JSON einbinden (siehe docker-compose.yml)
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_FILE=

# ntfy (optional): push for iPhones and anyone without the app. Each person subscribes to their own secret topic.
# NTFY_URL=https://ntfy.sh
# NTFY_PUBLIC_URL=       # address for the ntfy app if different (e.g. hub publishes via LAN)
# NTFY_TOKEN=            # only if the server denies anonymous publishing (token with write access to fh_*)
# HUB_PUBLIC_URL=        # reachable address of the hub; enables click links and reminder buttons

# --- Plugins ---
# Einzelne Plugins abschalten, z. B. PLUGINS_DISABLED=weather
PLUGINS_DISABLED=

# Nextcloud/CalDAV: Konten trägt jede Person selbst in der App ein. Optionaler gemeinsamer Kalender:
CALDAV_URL=
CALDAV_USERNAME=
CALDAV_PASSWORD=

# Habitica: eigene User-ID/API-Zugangsdaten verbindet jede Person in der App.
# Keine globalen Habitica-Nutzerzugänge. Der Server wird vom Betreiber festgelegt.
HABITICA_URL=https://habitica.com
# Leer = native Writes gesperrt. Erst nach geprüftem Single-Writer-Cutover freigeben;
# kommaseparierte geprüfte Server|Habitica-Konto-UUID-Paare, niemals Selbstfreigabe in der Kontomaske.
# Vollständige Voraussetzungen: docs/AUFGABENPROVIDER.md
HABITICA_NATIVE_WRITE_ACCOUNTS=

# Home Assistant: Einkaufsliste, Cookidoo-Essensplan und Haus-Karte
HOMEASSISTANT_URL=
HOMEASSISTANT_TOKEN=
HA_SHOPPING_TODO=todo.einkaufsliste
HA_RECIPE_SHOPPING_TODO=todo.cookidoo_einkaufsliste
HA_MEALPLAN_CALENDAR=calendar.cookidoo_speiseplan
# Haus-Karte in Heute: bis zu 6 Entitäts-IDs in Anzeigereihenfolge; leer = ausgeblendet.
# Beispiel: sensor.room_temperature,binary_sensor.baby_monitor,sensor.washer_status
HA_HOUSE_ENTITIES=
# Separate Schreibfreigabe: max. 6 light/switch/script/scene-IDs. Leer = keine Geräteaktionen.
# Die Leseauswahl oben erteilt niemals Schreibrechte. Nur bewusst familiengeeignete Aktionen freigeben.
HA_HOUSE_WRITE_ENTITIES=

# Shelfarr: Bücher und Hörbücher
SHELFARR_URL=
SHELFARR_TOKEN=
SHELFARR_LANGUAGE=de
SHELFARR_USER_MAP=

# Cookidoo: Rezepte suchen und in den Wochenplan legen (Konto mit Abo)
COOKIDOO_EMAIL=
COOKIDOO_PASSWORD=
COOKIDOO_COUNTRY=de
COOKIDOO_LANGUAGE=de-DE

# Wetter (Open-Meteo, kein Schlüssel)
WEATHER_LATITUDE=52.52
WEATHER_LONGITUDE=13.405
WEATHER_LOCATION_NAME=Zuhause

# Paperless-ngx: Dokumente und Fristen. Jede Person verbindet ihr eigenes API-Token in der App.
PAPERLESS_URL=
PAPERLESS_PUBLIC_URL=

# Seerr (Jellyseerr/Overseerr): Filme und Serien wünschen. Der Hub handelt als passender Seerr-Nutzer.
SEERR_URL=
SEERR_API_KEY=
SEERR_USER_MAP=
